# =============================================
# Noods N' Rice — Environment Configuration
# Copy this to .env and fill in your values
# cp .env.example .env
# =============================================

# ── Firebase Configuration ──
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# ── Admin Credentials ──
# Create the admin user in Firebase Console → Authentication → Users → Add user
# These are for your local reference only
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-strong-password

# ── CI/CD ──
# Generate a deploy token with: firebase login:ci
# Add it to GitHub Secrets as FIREBASE_TOKEN
# FIREBASE_TOKEN=
